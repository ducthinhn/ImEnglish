# ==============================================================================
# ImEnglish Environment Variables Template
# Copy this file to .env and fill in the actual values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application
SERVER_PORT=8080
CLIENT_URL=http://localhost:5173

# ==============================================================================
# PostgreSQL (Relational Database: Users, Friendships, Sessions, Flyway)
# ==============================================================================
POSTGRES_DB=imenglish_db
POSTGRES_USER=imenglish_user
POSTGRES_PASSWORD=imenglish_secret_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/imenglish_db

# ==============================================================================
# MongoDB (Unstructured Database: AI Conversations, Memories, Scenarios)
# ==============================================================================
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_secret_password
MONGO_DATABASE=imenglish_mongo
MONGO_PORT=27017
SPRING_DATA_MONGODB_URI=mongodb://mongo_admin:mongo_secret_password@localhost:27017/imenglish_mongo?authSource=admin

# ==============================================================================
# Redis (Caching, Session Blacklist, P2P Matching Queue)
# ==============================================================================
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ==============================================================================
# Security & JWT (Spring Security)
# ==============================================================================
# Generate a secure 256-bit or 512-bit secret key in production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# ==============================================================================
# AI Provider Keys (Google Gemini API / OpenAI)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_DEFAULT_PROVIDER=GEMINI

# ==============================================================================
# WebRTC / Coturn (STUN/TURN Server for P2P Voice Call)
# ==============================================================================
COTURN_PORT=3478
COTURN_MIN_PORT=49152
COTURN_MAX_PORT=65535
COTURN_SECRET=coturn_shared_secret_key
COTURN_REALM=imenglish.com
